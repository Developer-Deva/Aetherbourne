{
  "name": "Aetherbourne",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "password": "vscode",
      "webPort": "6080"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Aetherbourne",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
