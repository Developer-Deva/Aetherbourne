{
  "name": "C# Raylib GUI Dev Environment",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "password": "vscode",
      "webPort": "6080"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Virtual Monitor",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
